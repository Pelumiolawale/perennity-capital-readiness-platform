# Perennity Capital Readiness Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Airtable backend. Server-side only: read by the /api functions, which run
# locally under `vercel dev`. Do NOT prefix with VITE_ (see .env.example).
# PAT must include data.records:read and data.records:write scopes on the base.
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_PAT=patXXXXXXXXXXXXXX
AIRTABLE_ENGAGEMENTS_TABLE_ID=tblXXXXXXXXXXXXXX
