# Perennity Capital Readiness Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Airtable backend (required for user/assessment data persistence)
# PAT must include data.records:read and data.records:write scopes on the base.
VITE_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
VITE_AIRTABLE_PAT=patXXXXXXXXXXXXXX
VITE_AIRTABLE_ENGAGEMENTS_TABLE_ID=tblXXXXXXXXXXXXXX

# Anthropic API key (required for AI narrative and regulatory Q&A)
# SECURITY: This key is exposed to the browser. For production,
# proxy API calls through a serverless function (e.g. Vercel Edge Function).
VITE_ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXX
