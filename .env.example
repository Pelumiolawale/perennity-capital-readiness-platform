# Airtable Configuration
# Copy this file to .env.local and fill in your credentials.
#
# These are read ONLY by the /api serverless functions (api/engagement.js,
# api/leads.js, api/cron/benchmark-sync.js). Never give an Airtable variable
# a VITE_ prefix: Vite inlines every VITE_* value into the public bundle, and
# vite.config.js refuses to build if a secret-looking VITE_ variable is set.
#
# The PAT must carry data.records:read AND data.records:write scope on this
# base only (read: entitlement lookups; write: lead capture).
# In Vercel, set the same three variables for Production and Preview.

AIRTABLE_BASE_ID=appasxX7eC3QsmxeM
AIRTABLE_PAT=patXXXXXXXXXXXXXX
AIRTABLE_ENGAGEMENTS_TABLE_ID=tblRnd8BdQ65kuaej
